<Window x:Class="BuzArsiv.AramaPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buz Arşiv"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="760" SizeToContent="Height"
        FontFamily="{StaticResource Yazi}" UseLayoutRounding="True">

    <Grid Margin="24">
        <!-- Gölge -->
        <Border CornerRadius="22" Background="#01000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="#06142A"/>
            </Border.Effect>
        </Border>

        <!-- Buzlu cam -->
        <Border CornerRadius="22" BorderThickness="1.2" ClipToBounds="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AAE6F4FF" Offset="0"/>
                    <GradientStop Color="#33A9D4FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01C3560" Offset="0"/>
                    <GradientStop Color="#F212264A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Border Height="46" VerticalAlignment="Top" CornerRadius="22,22,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="Kar" IsHitTestVisible="False" ClipToBounds="True"/>

                <StackPanel>
                    <!-- Arama kutusu -->
                    <Grid Margin="22,16,22,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="❄" FontSize="24" Foreground="{StaticResource Buz}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="Yer" Grid.Column="1" Text="Dosya adının bir parçasını yaz…" FontSize="21"
                                   Foreground="#6F93BA" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="Kutu" Grid.Column="1" FontSize="21" Foreground="{StaticResource Yazi1}"
                                 Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Yazi1}"
                                 SelectionBrush="{StaticResource Buz}" VerticalAlignment="Center" Padding="0"/>
                    </Grid>
                    <Border Height="1" Background="#2E4F78" Margin="16,0"/>

                    <TextBlock x:Name="Baslik" Margin="24,10,24,4" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Soluk}"/>
                    <ListBox x:Name="Liste" Style="{StaticResource Liste}" ItemTemplate="{StaticResource DosyaSablonu}"
                             MaxHeight="420" Margin="12,0,12,4">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Aç" Click="MenuAc"/>
                                <MenuItem Header="Klasörünü aç" Click="MenuKlasor"/>
                                <MenuItem Header="Yolu kopyala" Click="MenuKopyala"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="Bos" Margin="24,8,24,14" FontSize="13" Foreground="{StaticResource Soluk}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- Alt satır -->
                    <Border Background="#22000000" CornerRadius="0,0,21,21" Padding="20,9">
                        <Grid>
                            <TextBlock x:Name="Ipucu" FontSize="11.5" Foreground="#7FA3C9" VerticalAlignment="Center"
                                       Text="↑ ↓ seç   ·   Enter aç   ·   Ctrl + Enter klasörünü aç   ·   Esc kapat"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SadeDugme}" Click="ZamanTiklandi" Content="🕓  Zaman çizelgesi"/>
                                <Button Style="{StaticResource SadeDugme}" Click="SilinenlerTiklandi" Content="🗑  Silinenler" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
