<Window x:Class="BuzArsiv.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buz Arşiv" Width="960" Height="660" MinWidth="760" MinHeight="480"
        Background="{StaticResource Zemin}" Foreground="{StaticResource Yazi1}"
        FontFamily="{StaticResource Yazi}" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource Zemin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Yan menü -->
        <Border Background="{StaticResource Zemin2}" BorderBrush="#1E3554" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <TextBlock Text="❄" FontSize="26" Foreground="{StaticResource Buz}" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Buz Arşiv" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="bul · geri getir" FontSize="11.5" Foreground="{StaticResource Soluk}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="SekmeZaman" Style="{StaticResource Sekme}" GroupName="s" Content="🕓   Zaman çizelgesi" Checked="SekmeDegisti"/>
                    <RadioButton x:Name="SekmeSilinen" Style="{StaticResource Sekme}" GroupName="s" Content="🗑   Silinenler" Checked="SekmeDegisti"/>
                    <RadioButton x:Name="SekmeAyar" Style="{StaticResource Sekme}" GroupName="s" Content="⚙   Ayarlar" Checked="SekmeDegisti"/>
                    <Button Style="{StaticResource Dugme}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="AramaTiklandi">
                        <TextBlock><Run Text="🔍  Ara"/><Run Text="   Ctrl + Shift + F" Foreground="{StaticResource Soluk}" FontSize="11.5"/></TextBlock>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <TextBlock x:Name="DurumKoruma" FontSize="12" Foreground="{StaticResource Soluk}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DurumAlan" FontSize="12" Foreground="{StaticResource Soluk}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Zaman çizelgesi -->
        <Grid x:Name="PanelZaman" Grid.Column="1" Margin="30,24,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Nereye kaydettim?" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Son bir ayda kaydettiğin ve indirdiğin dosyalar, en yenisi üstte. Adını hatırlamasan da ne zaman kaydettiğini hatırlarsın."
                           Foreground="{StaticResource Soluk}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14"/>
            </StackPanel>
            <WrapPanel x:Name="Cipler" Grid.Row="1" Margin="0,0,0,8"/>
            <ListBox x:Name="ZamanListesi" Grid.Row="2" Style="{StaticResource Liste}" ItemTemplate="{StaticResource DosyaSablonu}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Buz}" Margin="10,14,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Aç" Click="ZamanAc"/>
                        <MenuItem Header="Klasörünü aç" Click="ZamanKlasor"/>
                        <MenuItem Header="Yolu kopyala" Click="ZamanKopyala"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="ZamanBos" Grid.Row="2" Text="Son bir ayda bu klasörde kaydedilen dosya yok."
                       Foreground="{StaticResource Soluk}" Margin="10,10,0,0" Visibility="Collapsed"/>
        </Grid>

        <!-- Silinenler -->
        <Grid x:Name="PanelSilinen" Grid.Column="1" Margin="30,24,24,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Silinenler" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="SilinenAciklama" Foreground="{StaticResource Soluk}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14"/>
            </StackPanel>
            <TextBox x:Name="SilinenAra" Grid.Row="1" Style="{StaticResource Kutu}" Margin="0,0,0,10" MaxWidth="360" HorizontalAlignment="Left" Width="360"/>
            <TextBlock Grid.Row="1" Text="🔍  Silinenlerde ara…" Foreground="#6F93BA" FontSize="13.5" Margin="12,7,0,0" IsHitTestVisible="False"
                       x:Name="SilinenAraYer"/>
            <ListBox x:Name="SilinenListesi" Grid.Row="2" Style="{StaticResource Liste}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Simge}" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Ad}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Soluk}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                    <Run Text="{Binding Klasor, Mode=OneWay}"/><Run Text="   ·   "/><Run Text="{Binding Bilgi, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Style="{StaticResource AnaDugme}" Content="Geri getir" Click="GeriGetir" Tag="{Binding}"/>
                                <Button Style="{StaticResource Dugme}" Content="Farklı kaydet…" Click="FarkliKaydet" Tag="{Binding}" Margin="6,0,0,0"/>
                                <Button Style="{StaticResource SadeDugme}" Content="✕" Click="KaliciSil" Tag="{Binding}" Margin="4,0,0,0"
                                        ToolTip="Buz Arşiv'deki kopyayı kalıcı olarak sil"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="SilinenBos" Grid.Row="2" Margin="10,30,0,0" Visibility="Collapsed">
                <TextBlock Text="Burada henüz bir şey yok ❄" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="SilinenBosAciklama" Foreground="{StaticResource Soluk}" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="520" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <!-- Ayarlar -->
        <ScrollViewer x:Name="PanelAyar" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,24" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Ayarlar" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="İZLENEN KLASÖRLER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Buz}"/>
                <TextBlock Text="Buz Arşiv bu klasörlerde arar ve buradan silinen dosyaları saklar. Alt klasörler de dahildir."
                           Foreground="{StaticResource Soluk}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                <ItemsControl x:Name="KlasorListesi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Kart}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Etiket}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Yol}" FontSize="11.5" Foreground="{StaticResource Soluk}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SadeDugme}" Content="Çıkar" Click="KlasorCikar" Tag="{Binding Yol}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Dugme}" Content="+  Klasör ekle…" HorizontalAlignment="Left" Click="KlasorEkle" Margin="0,4,0,24"/>

                <TextBlock Text="SİLİNENLERİ KORUMA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Buz}"/>
                <TextBlock Foreground="{StaticResource Soluk}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="Dosyaların kopyası yalnızca bu bilgisayarda durur; internete hiçbir şey gönderilmez. Aynı dosya iki kez saklanmaz."/>
                <TextBlock Text="Bundan büyük dosyaları koruma" Margin="0,0,0,6"/>
                <WrapPanel x:Name="SecimBoyut" Margin="0,0,0,12"/>
                <TextBlock Text="Buzdolabı en fazla bu kadar yer kaplasın" Margin="0,0,0,6"/>
                <WrapPanel x:Name="SecimAlan" Margin="0,0,0,12"/>
                <TextBlock Text="Silinenleri bu kadar sakla" Margin="0,0,0,6"/>
                <WrapPanel x:Name="SecimGun" Margin="0,0,0,14"/>
                <CheckBox x:Name="Duraklat" Style="{StaticResource Anahtar}" Content="Korumayı duraklat" Margin="0,0,0,24"/>

                <TextBlock Text="GENEL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Buz}" Margin="0,0,0,10"/>
                <CheckBox x:Name="Baslangic" Style="{StaticResource Anahtar}" Content="Windows açılınca Buz Arşiv de başlasın" Margin="0,0,0,10"/>
                <TextBlock Foreground="{StaticResource Soluk}" TextWrapping="Wrap">
                    <Run Text="Arama kısayolu: "/><Run x:Name="KisayolYazisi" Text="Ctrl + Shift + F" Foreground="{StaticResource Yazi1}" FontWeight="SemiBold"/>
                </TextBlock>
                <Button Style="{StaticResource Dugme}" Content="Buzdolabı klasörünü aç" HorizontalAlignment="Left" Click="DepoKlasorunuAc" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
