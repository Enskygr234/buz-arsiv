<Project Sdk="Microsoft.NET.Sdk">

  <!-- Buz Arşiv'in çekirdeğini (dizin ve depo) gerçek dosyalarla sınar: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BuzArsiv\Metin.cs" />
    <Compile Include="..\BuzArsiv\Dizin.cs" />
    <Compile Include="..\BuzArsiv\Depo.cs" />
  </ItemGroup>

</Project>
